# ============================================================
# Company Research Agent — 环境变量模板
# 复制为 .env 后填写；.env 禁止提交（已在 .gitignore 中）
# 环境变量优先级高于 config/*.yaml
# ============================================================

# ---- 运行模式 ------------------------------------------------
# fixture : 无任何 API key 也能跑通全链路，用本地固定检索结果 + 确定性模型 stub（默认）
# live    : 接真实模型 API + 真实 Tavily + 真实数据库
APP_MODE=fixture

# ---- 日志 ----------------------------------------------------
LOG_LEVEL=INFO

# ---- 模型（仅 live 模式必填）---------------------------------
# 推荐 OpenRouter：一把 key 覆盖所有模型角色
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# 备选：直连 provider（不配 OpenRouter 时生效）
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- 检索（仅 live 模式必填）---------------------------------
# 建议只设在系统「用户变量」里，不要写进本文件，避免误提交。
TAVILY_API_KEY=

# ⚠️ Tavily 免费额度护栏：默认全部关闭，装了 key 也不会发起真实请求。
# 只有三项同时满足才会真正调用：APP_MODE=live + TAVILY_LIVE_ENABLED=true + TAVILY_MAX_CALLS>0
# 非必要不调用；先用 TAVILY_DRY_RUN=true 看会发哪些 query，用 TAVILY_CACHE_DIR 复用已取回结果。
# TAVILY_MAX_CALLS 是「每次运行」的硬预算：/research 每请求独立一份 CallBudget，
# Studio 入口是进程级单例；真实次数以 CallBudget.calls_made 为准。
# 注意：APP_MODE=live 且没有模型 key 时，build_graph() 构造阶段就抛 MissingLLMCredentials；
# 只想放行真实检索、不接模型，请同时设 FEATURES_STRUCTURED_OUTPUT=false。
TAVILY_LIVE_ENABLED=false
TAVILY_MAX_CALLS=0
TAVILY_DRY_RUN=false
TAVILY_CACHE_DIR=./evals/cache/tavily

# ---- 持久化 --------------------------------------------------
# sqlite | postgres
CHECKPOINTER=sqlite
# fixture 模式默认落在项目内 data/ 目录，便于复现
DATABASE_URL=sqlite:///./data/checkpoints.db
# Postgres Saver 用（真实实测阶段切换）
POSTGRES_DSN=

# ---- 评测 ----------------------------------------------------
EVAL_DATASET_PATH=./evals/golden.jsonl
EVAL_SCORECARD_PATH=./evals/scorecard.json
FIXTURE_PATH=./evals/fixtures/tavily_responses.json

# ---- 功能开关（A/B 对照实验用，均可用环境变量覆盖）-----------
# self_correction : 关掉后证据不足直接降级，不改写 query 重搜
FEATURES_SELF_CORRECTION=true
FEATURES_STRUCTURED_OUTPUT=true
FEATURES_INLINE_CITATIONS=true
# human_review : S6 HITL。默认 false（无人值守不中断，主图严格 7 节点）
# 真要人工复核：FEATURES_HUMAN_REVIEW=true 且 AUTO_APPROVE_REVIEW=false，
# 再用 CLI 两步式 --review / --resume，见 docs/ACTION_PLAN.md 第 10 节。
FEATURES_HUMAN_REVIEW=false

# ---- HITL ----------------------------------------------------
# fixture / CI 环境下自动确认，避免流水线阻塞；本地手动复核设为 false
AUTO_APPROVE_REVIEW=true
