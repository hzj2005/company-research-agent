# ============================================================
# Company Research Agent — 环境变量模板
# 复制为 .env 后填写；.env 禁止提交（已在 .gitignore 中）
# 环境变量优先级高于 config/*.yaml
# ============================================================

# ---- 运行模式 ------------------------------------------------
# fixture : 无任何 API key 也能跑通全链路，用本地固定检索结果 + 确定性模型 stub（默认）
# live    : 接真实模型 API + 真实 Tavily + 真实数据库
APP_MODE=fixture

# ---- 日志 ----------------------------------------------------
LOG_LEVEL=INFO

# ---- 模型（仅 live 模式必填）---------------------------------
# 推荐 OpenRouter：一把 key 覆盖所有模型角色
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash

# 备选：直连 provider（不配 OpenRouter 时生效）
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- 检索（仅 live 模式必填）---------------------------------
TAVILY_API_KEY=

# ---- 持久化 --------------------------------------------------
# sqlite | postgres
CHECKPOINTER=sqlite
# fixture 模式默认落在项目内 data/ 目录，便于复现
DATABASE_URL=sqlite:///./data/checkpoints.db
# Postgres Saver 用（真实实测阶段切换）
POSTGRES_DSN=

# ---- 评测 ----------------------------------------------------
EVAL_DATASET_PATH=./evals/golden.jsonl
EVAL_SCORECARD_PATH=./evals/scorecard.json
FIXTURE_PATH=./evals/fixtures/tavily_responses.json

# ---- HITL ----------------------------------------------------
# fixture / CI 环境下自动确认，避免流水线阻塞；本地手动复核设为 false
AUTO_APPROVE_REVIEW=true
